(file C:\Users\Asus\AppData\Local\Temp\ST_61b0_000002.tmp not found)

. 
. capture program drop add_balance

. program define add_balance
  1.     syntax varname(numeric), Label(string) Group(string) [Core(integer 1)]
  2. 
.     quietly summarize `varlist' [aw=Weight] if sample98 & Weight > 0 & Weight
>  < . & !missing(`varlist')
  3.     scalar N98 = r(N)
  4.     scalar M98 = r(mean)
  5.     scalar V98 = r(Var)
  6.     scalar SD98 = r(sd)
  7. 
.     quietly summarize `varlist' [aw=Weight] if sample99 & Weight > 0 & Weight
>  < . & !missing(`varlist')
  8.     scalar N99 = r(N)
  9.     scalar M99 = r(mean)
 10.     scalar V99 = r(Var)
 11.     scalar SD99 = r(sd)
 12. 
.     scalar DIFF = M99 - M98
 13.     scalar DEN = sqrt((V98 + V99) / 2)
 14.     scalar SMD = .
 15.     if DEN > 0 & DEN < . {
 16.         scalar SMD = DIFF / DEN
 17.     }
 18.     scalar ABS_SMD = abs(SMD)
 19. 
.     post balancepost ("`varlist'") (`"`label'"') (`"`group'"') (`core') ///
>         (N98) (N99) (M98) (M99) (DIFF) (SD98) (SD99) (SMD) (ABS_SMD)
 20. end

. 
